---
// index.astro — TREEWEEK landing page
// Composes all sections in the intended visitor journey.
import BaseLayout from '../layouts/BaseLayout.astro';

import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Interlude from '../components/Interlude.astro';
import SimonNote from '../components/SimonNote.astro';
import Postcards from '../components/Postcards.astro';
import Ingredients from '../components/Ingredients.astro';
import Venue from '../components/Venue.astro';
import Tickets from '../components/Tickets.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

import testimonials from '../content/testimonials.json';
---

<BaseLayout>
  <Nav />

  <main>
    <Hero />

    <Interlude
      quote={testimonials[0].quote}
      attribution={testimonials[0].attribution}
      tone="cream-deep"
    />

    <SimonNote />

    <Postcards />

    <Interlude
      quote={testimonials[1].quote}
      attribution={testimonials[1].attribution}
      tone="cream"
    />

    <Ingredients />

    <Interlude
      quote={testimonials[2].quote}
      attribution={testimonials[2].attribution}
      tone="cream-deep"
    />

    <Venue />

    <Interlude
      quote={testimonials[3].quote}
      attribution={testimonials[3].attribution}
      tone="cream"
    />

    <Tickets />

    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>
