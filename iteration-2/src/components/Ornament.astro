---
// Ornament.astro — reusable decorative SVGs
// Uses currentColor so it inherits the surrounding text color.
//
// Types:
//   'star'    — small four-point sparkle
//   'divider' — horizontal rule with center star
//   'sprig'   — small leaf sprig
//   'seal'    — circular wax-seal-style stamp
//
// Size controlled via CSS custom prop --ornament-size (default 1em)

interface Props {
  type?: 'star' | 'divider' | 'sprig' | 'seal';
  size?: string;
  class?: string;
  label?: string;
}

const { type = 'star', size = '1em', class: className = '', label } = Astro.props;
const style = `--ornament-size: ${size};`;
const ariaProps = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

{type === 'star' && (
  <svg
    class={`ornament ornament--star ${className}`}
    style={style}
    viewBox="0 0 24 24"
    fill="currentColor"
    {...ariaProps}
  >
    <path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" />
  </svg>
)}

{type === 'divider' && (
  <svg
    class={`ornament ornament--divider ${className}`}
    style={style}
    viewBox="0 0 200 12"
    preserveAspectRatio="xMidYMid meet"
    fill="none"
    stroke="currentColor"
    stroke-width="0.6"
    stroke-linecap="round"
    {...ariaProps}
  >
    <line x1="10" y1="6" x2="88" y2="6" />
    <path
      d="M100 2 L101 5.5 L104 6 L101 6.5 L100 10 L99 6.5 L96 6 L99 5.5 Z"
      fill="currentColor"
      stroke="none"
    />
    <line x1="112" y1="6" x2="190" y2="6" />
  </svg>
)}

{type === 'sprig' && (
  <svg
    class={`ornament ornament--sprig ${className}`}
    style={style}
    viewBox="0 0 40 40"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...ariaProps}
  >
    <path d="M20 6 L20 34" />
    <path d="M20 12 Q13 12 12 18 Q17 18 20 14" fill="currentColor" fill-opacity="0.25" />
    <path d="M20 18 Q28 18 29 24 Q23 24 20 20" fill="currentColor" fill-opacity="0.25" />
    <path d="M20 24 Q13 24 12 30 Q17 30 20 26" fill="currentColor" fill-opacity="0.25" />
  </svg>
)}

{type === 'seal' && (
  <svg
    class={`ornament ornament--seal ${className}`}
    style={style}
    viewBox="0 0 60 60"
    {...ariaProps}
  >
    <circle cx="30" cy="30" r="26" fill="currentColor" fill-opacity="0.9" />
    <circle cx="30" cy="30" r="26" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1.5 1.5" opacity="0.4" />
    <path
      d="M30 16 L32.5 26 L42 26 L34.2 32 L37 42 L30 36 L23 42 L25.8 32 L18 26 L27.5 26 Z"
      fill="var(--color-cream, #f7efdf)"
      opacity="0.85"
    />
  </svg>
)}

<style>
  .ornament {
    width: var(--ornament-size);
    height: var(--ornament-size);
    display: inline-block;
    vertical-align: middle;
    color: var(--color-gold-old);
    flex-shrink: 0;
  }

  .ornament--divider {
    width: min(200px, 60%);
    height: auto;
    color: var(--color-gold-old);
    opacity: 0.7;
  }

  .ornament--star {
    color: var(--color-gold-old);
    opacity: 0.85;
  }

  .ornament--sprig {
    color: var(--color-forest-soft);
    opacity: 0.75;
  }
</style>
