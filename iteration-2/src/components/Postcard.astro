---
// Postcard.astro — a single tilted photo postcard with 3D hover-flip.
// Front: photo + year + spell name.
// Back: parchment, handwritten Caveat text, signature.
// - Hover flips on pointer devices (@media hover: hover)
// - Tap toggles .flipped on touch devices (JS below)
// - Keyboard: :focus-within also flips
// - Semantic <button> for a11y; aria-label describes the interaction
//
// Requires photo at /public/images/postcards/tw{n}.jpg.

interface Props {
  number: string;   // "I" / "II"
  year: number;     // 2024 / 2025
  spell: string;    // "The Initial Spell"
  photo: string;    // "/images/postcards/tw1.jpg"
  back: string;     // handwritten text for the back
  tilt?: number;    // deg, default 0
  offsetY?: string; // e.g. "1rem", default "0"
}

const {
  number,
  year,
  spell,
  photo,
  back,
  tilt = 0,
  offsetY = '0',
} = Astro.props;

const cornerLabel = `TW${number === 'I' ? 1 : number === 'II' ? 2 : 3}`;
const style = `--tilt: ${tilt}deg; --offset-y: ${offsetY};`;
---

<button
  class="postcard-wrap"
  style={style}
  aria-label={`TREEWEEK ${number}, ${year} — ${spell}. Activate to read.`}
  data-postcard
>
  <div class="postcard">
    <!-- FRONT -->
    <div class="face face--front">
      <div
        class="face-photo image-slot"
        data-label={`${cornerLabel} photo · drop at ${photo}`}
      >
        <img
          src={photo}
          alt={`TREEWEEK ${number} ${year}`}
          onerror="this.remove()"
          loading="lazy"
        />
        <span class="corner-emboss" aria-hidden="true">{cornerLabel}</span>
      </div>
      <div class="face-caption">
        <div class="edition">TREEWEEK {number}</div>
        <div class="year">{year}</div>
        <div class="spell">{spell}</div>
      </div>
    </div>

    <!-- BACK -->
    <div class="face face--back">
      <span class="corner-emboss corner-emboss--dark" aria-hidden="true">{cornerLabel}</span>
      <div class="back-text">
        <p>{back}</p>
      </div>
      <div class="back-sign">TREEWEEK {number}</div>
    </div>
  </div>
</button>

<style>
  .postcard-wrap {
    position: relative;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 3 / 4;
    perspective: 1400px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
    transform: rotate(var(--tilt)) translateY(var(--offset-y));
    transition: transform var(--dur-med) var(--ease-out);
    /* subtle drop shadow on the wrapper for depth */
    filter: drop-shadow(0 6px 18px rgba(43, 38, 32, 0.14));
  }

  .postcard-wrap:hover {
    z-index: 5;
    transform: rotate(0deg) translateY(calc(var(--offset-y) - 0.5rem));
  }

  .postcard {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--dur-slow) var(--ease-flip);
  }

  /* Hover-flip only on pointer devices */
  @media (hover: hover) and (pointer: fine) {
    .postcard-wrap:hover .postcard,
    .postcard-wrap:focus-visible .postcard {
      transform: rotateY(180deg);
    }
  }

  /* Touch / JS-toggled flip */
  .postcard-wrap.flipped .postcard {
    transform: rotateY(180deg);
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--color-parchment);
    display: flex;
    flex-direction: column;
  }

  .face--back {
    transform: rotateY(180deg);
    background: var(--color-parchment);
    padding: var(--space-l);
    justify-content: space-between;
    /* subtle paper texture via gradients */
    background-image:
      radial-gradient(ellipse at top left, rgba(165, 133, 72, 0.06), transparent 60%),
      radial-gradient(ellipse at bottom right, rgba(193, 156, 143, 0.08), transparent 60%);
  }

  /* FRONT ----------------------------------------------- */
  .face-photo {
    flex: 1 1 auto;
    background-color: var(--color-cream-deep);
    position: relative;
    overflow: hidden;
  }

  .face-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
  }

  .face-caption {
    padding: var(--space-s) var(--space-m);
    background: var(--color-parchment);
    text-align: left;
    border-top: 1px solid var(--color-hairline);
  }

  .edition {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-old);
    margin-bottom: 0.15em;
  }

  .year {
    font-family: var(--font-display);
    font-size: var(--text-l);
    font-weight: 500;
    color: var(--color-forest-deep);
    line-height: 1;
  }

  .spell {
    font-family: var(--font-display);
    font-size: var(--text-s);
    font-style: italic;
    color: var(--color-forest-soft);
    margin-top: 0.3em;
  }

  /* CORNER EMBOSS --------------------------------------- */
  .corner-emboss {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.75);
    text-shadow:
      0 1px 0 rgba(0, 0, 0, 0.15),
      0 -1px 0 rgba(255, 255, 255, 0.25);
    background: rgba(43, 38, 32, 0.15);
    padding: 0.3em 0.55em;
    border-radius: 100px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 2;
  }

  .corner-emboss--dark {
    color: rgba(75, 97, 81, 0.6);
    background: rgba(165, 133, 72, 0.08);
    text-shadow: none;
    backdrop-filter: none;
  }

  /* BACK ------------------------------------------------ */
  .back-text {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-l);
  }

  .back-text p {
    font-family: var(--font-hand);
    font-size: var(--text-l);
    color: var(--color-ink);
    line-height: 1.35;
    text-align: left;
  }

  .back-sign {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-old);
    text-align: right;
    align-self: flex-end;
  }

  /* Focus visibility */
  .postcard-wrap:focus-visible {
    outline: none;
  }
  .postcard-wrap:focus-visible .face--front,
  .postcard-wrap:focus-visible .face--back {
    box-shadow: 0 0 0 3px var(--color-gold-old);
  }
</style>

<script>
  // Touch devices: tap to toggle. Uses pointer detection.
  // Keyboard: Space/Enter toggles too (via <button> default).
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-postcard]');
  const isCoarse = window.matchMedia('(hover: none) or (pointer: coarse)').matches;

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // For coarse pointers, toggle .flipped explicitly.
      // For fine pointers, hover handles it — but clicking should still work.
      btn.classList.toggle('flipped');
    });
  });
</script>
