---
// Footer.astro — minimal
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-mark">
      <span class="footer-symbol">✦</span> TREEWEEK
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="mailto:TREEWEEK@nowmedia.org">Contact</a>
      <a href="https://x.com/simon_ohler" target="_blank" rel="noopener">@simon_ohler</a>
      <a href="https://simonohler.com/TREEWEEK-TWO" target="_blank" rel="noopener">TREEWEEK II</a>
      <a href="https://seegut-blaueblume.de/en/" target="_blank" rel="noopener">Venue</a>
      <a href="https://coliven.com/events/eb0cc6dae9a7" target="_blank" rel="noopener">Tickets</a>
    </nav>

    <p class="footer-copy">
      Brandenburg, Germany <span class="dot">·</span> September 22 – 29, 2026
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-cream);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .footer-mark {
    font-family: var(--font-display);
    font-size: var(--text-s);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-forest-deep);
  }

  .footer-symbol {
    color: var(--color-gold-old);
    font-style: normal;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .footer-links a:hover {
    color: var(--color-forest-deep);
  }

  .footer-copy {
    width: 100%;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    opacity: 0.5;
    margin-top: var(--space-s);
  }

  .dot {
    display: inline-block;
    margin-inline: 0.35em;
    color: var(--color-rose-dust);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
    .footer-copy {
      text-align: left;
    }
  }
</style>
