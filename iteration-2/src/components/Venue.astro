---
// Venue.astro — Seegut Blaue Blume
// Editorial split: text/quote on left, asymmetric photo grid on right.
// Whole section washed in dusty-blue tint (Blaue Blume = "Blue Flower")
// Photos live in /public/images/venue/ (pre-downloaded from Blaue Blume site)
import Ornament from './Ornament.astro';
---

<section class="venue section">
  <div class="container venue-grid">
    <!-- LEFT: text -->
    <div class="venue-text fade-in">
      <span class="eyebrow">The place</span>

      <h2 class="venue-h">Seegut<br />Blaue Blume</h2>

      <div class="venue-quote">
        <p class="venue-quote-de">
          Unsere Absicht ist nichts weniger als<br />die Wiederverzauberung der Welt.
        </p>
        <p class="venue-quote-en">
          Our aim is nothing less than<br />the re-enchantment of the world.
        </p>
      </div>

      <div class="venue-body">
        <p>
          An 8-hectare manor in the Uckermark, 90 minutes from Berlin. Your own lake and small island. Forest, meadows, two saunas, and a fireplace with a sweat lodge in the woods.
        </p>
        <p class="venue-body-quiet">
          Seven hectares from everything else. The phone grows quieter of its own accord.
        </p>
      </div>

      <div class="elements" aria-label="Elements">
        <div class="element">
          <span class="element-glyph">〜</span>
          <span class="element-name">Water</span>
        </div>
        <div class="element">
          <span class="element-glyph">⊕</span>
          <span class="element-name">Earth</span>
        </div>
        <div class="element">
          <span class="element-glyph">◈</span>
          <span class="element-name">Fire</span>
        </div>
        <div class="element">
          <span class="element-glyph">∞</span>
          <span class="element-name">Air</span>
        </div>
      </div>

      <a
        href="https://seegut-blaueblume.de/en/"
        target="_blank"
        rel="noopener"
        class="venue-link text-cta"
      >
        Visit Seegut Blaue Blume <span class="arrow">→</span>
      </a>
    </div>

    <!-- RIGHT: photo grid -->
    <div class="venue-photos fade-in">
      <figure class="ph ph--lake image-slot" data-label="Lake at dawn">
        <img
          src="/images/venue/lake-reflection.jpg"
          alt="Mist over the lake in the morning at Seegut Blaue Blume"
          onerror="this.remove()"
          loading="lazy"
        />
      </figure>
      <figure class="ph ph--manor image-slot" data-label="Manor by day">
        <img
          src="/images/venue/manor-day.jpg"
          alt="The 1922 manor house with ivy and garden"
          onerror="this.remove()"
          loading="lazy"
        />
      </figure>
      <figure class="ph ph--fire image-slot" data-label="Fireside hall">
        <img
          src="/images/venue/reception-fireplace.jpg"
          alt="Reception hall with fireplace"
          onerror="this.remove()"
          loading="lazy"
        />
      </figure>
      <figure class="ph ph--sauna image-slot" data-label="Barrel sauna">
        <img
          src="/images/venue/sauna.jpg"
          alt="Barrel sauna by water in evening light"
          onerror="this.remove()"
          loading="lazy"
        />
      </figure>
      <figure class="ph ph--path image-slot" data-label="Garden path">
        <img
          src="/images/venue/garden-path.jpg"
          alt="Grass paths along the shore in summer"
          onerror="this.remove()"
          loading="lazy"
        />
      </figure>
      <figure class="ph ph--aerial image-slot" data-label="Aerial in autumn">
        <img
          src="/images/venue/aerial-autumn.jpg"
          alt="Aerial view of the estate in autumn"
          onerror="this.remove()"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .venue {
    background: var(--color-blue-tint);
    position: relative;
  }

  /* Soft gradient transition at top and bottom to blend with cream sections */
  .venue::before,
  .venue::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 3rem;
    pointer-events: none;
  }
  .venue::before {
    top: 0;
    background: linear-gradient(180deg, var(--color-cream-deep), transparent);
    opacity: 0.5;
  }
  .venue::after {
    bottom: 0;
    background: linear-gradient(0deg, var(--color-cream), transparent);
    opacity: 0.5;
  }

  .venue-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .venue-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-2xl);
    }
  }

  /* TEXT COLUMN */
  .venue-text {
    max-width: 34rem;
  }

  .venue-h {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--color-forest-deep);
    margin-block: var(--space-s) var(--space-l);
    letter-spacing: -0.02em;
    padding-top: 0.15em;
  }

  .venue-quote {
    margin-bottom: var(--space-l);
    padding-left: var(--space-m);
    border-left: 2px solid var(--color-blue-dust);
  }

  .venue-quote-de {
    font-family: var(--font-display);
    font-size: var(--text-l);
    font-style: italic;
    font-weight: 400;
    color: var(--color-forest-deep);
    line-height: 1.35;
    margin-bottom: var(--space-2xs);
  }

  .venue-quote-en {
    font-family: var(--font-display);
    font-size: var(--text-m);
    font-style: italic;
    color: var(--color-ink-muted);
    line-height: 1.35;
  }

  .venue-body p {
    font-family: var(--font-body);
    font-size: var(--text-m);
    color: var(--color-ink);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-m);
  }

  .venue-body-quiet {
    color: var(--color-ink-muted) !important;
    font-style: italic;
  }

  /* Four elements */
  .elements {
    display: flex;
    gap: var(--space-l);
    margin-block: var(--space-l);
    flex-wrap: wrap;
  }

  .element {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
  }

  .element-glyph {
    font-size: var(--text-l);
    color: var(--color-blue-dust);
    line-height: 1;
    opacity: 0.85;
  }

  .element-name {
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .venue-link {
    margin-top: var(--space-m);
    display: inline-flex;
  }

  /* PHOTOS ---------------------------------------------- */
  .venue-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(4, minmax(6rem, auto));
    grid-template-areas:
      "lake  manor"
      "lake  fire"
      "sauna path"
      "aerial aerial";
    gap: var(--space-2xs);
  }

  @media (min-width: 640px) {
    .venue-photos {
      grid-template-rows: repeat(4, minmax(8rem, auto));
      gap: var(--space-xs);
    }
  }

  .ph {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--color-cream-deep);
  }

  .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .ph:hover img {
    transform: scale(1.03);
  }

  .ph--lake   { grid-area: lake; }
  .ph--manor  { grid-area: manor; }
  .ph--fire   { grid-area: fire; }
  .ph--sauna  { grid-area: sauna; }
  .ph--path   { grid-area: path; }
  .ph--aerial { grid-area: aerial; aspect-ratio: 2.2 / 1; }
</style>
