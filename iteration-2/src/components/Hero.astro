---
// Hero.astro — editorial invitation on cream
// No photo. Composition is: ornament / eyebrow / TREEWEEK title / divider /
// edition line / dates / venue / handwritten script / text CTA.
import Ornament from './Ornament.astro';
---

<section id="top" class="hero">
  <div class="hero-inner">
    <Ornament type="star" size="1.25rem" class="hero-star" />

    <span class="hero-eyebrow">You are invited to</span>

    <h1 class="hero-title">TREEWEEK</h1>

    <Ornament type="divider" class="hero-divider" />

    <div class="hero-edition">III <span class="dot">·</span> THR33W33K</div>

    <div class="hero-dates">September 22 – 29, 2026</div>

    <div class="hero-venue">Seegut Blaue Blume <span class="dot">·</span> Brandenburg, Germany</div>

    <p class="hero-script">it's main character season</p>

    <a
      href="https://coliven.com/events/eb0cc6dae9a7"
      target="_blank"
      rel="noopener"
      class="hero-cta text-cta"
    >
      Come to the forest <span class="arrow">→</span>
    </a>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span>scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3xl) var(--space-m) var(--space-2xl);
    background: var(--color-cream);
    overflow: hidden;
  }

  /* Subtle radial glow to add warmth without a photo */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(ellipse 60% 55% at 50% 40%, rgba(255, 230, 190, 0.35) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 20% 80%, rgba(193, 156, 143, 0.15) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 44rem;
  }

  .hero-star {
    margin-bottom: var(--space-l);
    color: var(--color-gold-old);
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-l);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 300;
    font-style: italic;
    font-variation-settings: 'opsz' 144;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--color-forest-deep);
    white-space: nowrap;
    margin-bottom: var(--space-l);
  }

  .hero-divider {
    margin-bottom: var(--space-m);
    color: var(--color-gold-old);
  }

  .hero-edition {
    font-family: var(--font-display);
    font-size: var(--text-m);
    font-weight: 500;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-forest-soft);
    margin-bottom: var(--space-xs);
  }

  .hero-dates {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    color: var(--color-forest-deep);
    margin-bottom: var(--space-2xs);
  }

  .hero-venue {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-l);
  }

  .dot {
    display: inline-block;
    margin-inline: 0.35em;
    color: var(--color-rose-dust);
  }

  .hero-script {
    font-family: var(--font-hand);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-rose-deep);
    line-height: 1;
    margin-bottom: var(--space-xl);
    letter-spacing: 0.01em;
  }

  .hero-cta {
    /* inherits .text-cta from global.css */
  }

  .hero-scroll {
    position: absolute;
    bottom: var(--space-l);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-ink-muted);
    opacity: 0.5;
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    user-select: none;
    pointer-events: none;
  }

  .scroll-line {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, currentColor, transparent);
    animation: scrollPulse 2.4s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50%       { opacity: 1;   transform: scaleY(1.15); }
  }

  @media (max-width: 480px) {
    .hero-title {
      letter-spacing: -0.03em;
    }
  }
</style>
