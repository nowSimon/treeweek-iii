---
// Nav.astro — minimal persistent top nav
// Wordmark left, single text CTA right.
// Border-bottom appears once scrolled.
---

<header id="nav" class="nav">
  <div class="nav-inner">
    <a href="#top" class="nav-mark">
      <span class="nav-mark-symbol">✦</span>
      <span class="nav-mark-word">TREEWEEK</span>
    </a>
    <a
      href="https://coliven.com/events/eb0cc6dae9a7"
      target="_blank"
      rel="noopener"
      class="nav-cta"
    >
      Come <span class="arrow">→</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-block: var(--space-s);
    background: rgba(247, 239, 223, 0);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out),
      padding-block var(--dur-med) var(--ease-out);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
  }

  .nav.scrolled {
    background: rgba(247, 239, 223, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--color-hairline);
    padding-block: var(--space-2xs);
  }

  .nav-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-m);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  @media (min-width: 640px) {
    .nav-inner { padding-inline: var(--space-l); }
  }
  @media (min-width: 1024px) {
    .nav-inner { padding-inline: var(--space-xl); }
  }

  .nav-mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-display);
    font-size: var(--text-s);
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.1em;
    color: var(--color-forest-deep);
    text-decoration: none;
    transition: opacity var(--dur-fast);
  }

  .nav-mark:hover { opacity: 0.7; }

  .nav-mark-symbol {
    color: var(--color-gold-old);
    font-style: normal;
  }

  .nav-cta {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-forest-deep);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    text-decoration-color: var(--color-gold-old);
    transition:
      color var(--dur-fast),
      text-decoration-color var(--dur-fast);
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    color: var(--color-gold-old);
    text-decoration-color: var(--color-forest-deep);
  }

  .nav-cta .arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav-cta:hover .arrow {
    transform: translateX(0.3em);
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => {
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 48);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
