---
// EnvelopeCard.astro — TW3 postcard as an envelope with a pop-out invitation.
// Whole card is a link to Coliven.
// On hover / focus: invitation slides up out of the envelope.
// Sits alongside two <Postcard>s in <Postcards />.
---

<a
  href="https://coliven.com/events/eb0cc6dae9a7"
  target="_blank"
  rel="noopener"
  class="envelope-wrap"
  aria-label="TREEWEEK III — Get your ticket at Coliven"
  style="--tilt: -1deg; --offset-y: 0.5rem;"
>
  <div class="envelope">
    <!-- BACKDROP (behind everything) -->
    <div class="backdrop" aria-hidden="true"></div>

    <!-- INVITATION (behind the envelope front, slides up) -->
    <div class="invitation" aria-hidden="true">
      <div class="inv-eyebrow">You are invited to</div>
      <div class="inv-title">TREEWEEK III</div>
      <div class="inv-dates">September 22 – 29, 2026</div>
      <div class="inv-script">Come LARP your higher self</div>
      <div class="inv-cta">Get your ticket →</div>
    </div>

    <!-- ENVELOPE FRONT (with wax seal) -->
    <div class="env-front">
      <div class="env-flap"></div>
      <div class="env-body">
        <div class="env-address">
          <span class="env-line">You.</span>
          <span class="env-line">September 22 – 29, 2026.</span>
          <span class="env-line env-line--small">Seegut Blaue Blume, Brandenburg.</span>
        </div>
        <div class="wax-seal" aria-hidden="true">
          <div class="wax-seal-inner">✦</div>
        </div>
      </div>
      <span class="corner-emboss" aria-hidden="true">TW3</span>
    </div>

    <!-- Front caption to match Postcard visual footprint -->
    <div class="env-caption">
      <div class="edition">TREEWEEK III</div>
      <div class="year">2026</div>
      <div class="spell">Main Character Season</div>
    </div>
  </div>
</a>

<style>
  .envelope-wrap {
    position: relative;
    display: block;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    color: inherit;
    transform: rotate(var(--tilt)) translateY(var(--offset-y));
    transition: transform var(--dur-med) var(--ease-out);
    filter: drop-shadow(0 6px 18px rgba(43, 38, 32, 0.14));
    cursor: pointer;
  }

  .envelope-wrap:hover,
  .envelope-wrap:focus-visible {
    z-index: 5;
    transform: rotate(0deg) translateY(calc(var(--offset-y) - 0.5rem));
    outline: none;
  }

  .envelope-wrap:focus-visible .env-front {
    box-shadow: 0 0 0 3px var(--color-gold-old);
  }

  .envelope {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--color-parchment);
    display: flex;
    flex-direction: column;
  }

  /* BACKDROP -------------------------------------------- */
  .backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top, rgba(139, 165, 179, 0.25), transparent 65%),
      linear-gradient(180deg, var(--color-blue-tint) 0%, var(--color-parchment) 60%);
    z-index: 1;
  }

  /* INVITATION (initially mostly hidden inside envelope) */
  .invitation {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 8%;
    bottom: 18%;
    background: var(--color-cream);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-s);
    padding: var(--space-m) var(--space-s);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-2xs);
    /* Start position: mostly hidden inside envelope */
    transform: translateY(58%);
    transition: transform var(--dur-slow) var(--ease-flip);
    z-index: 2;
    box-shadow:
      0 -2px 4px rgba(43, 38, 32, 0.06),
      0 -6px 12px rgba(43, 38, 32, 0.08);
  }

  .envelope-wrap:hover .invitation,
  .envelope-wrap:focus-visible .invitation {
    transform: translateY(-6%);
    z-index: 4; /* rise above envelope front */
  }

  .inv-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .inv-title {
    font-family: var(--font-display);
    font-size: var(--text-l);
    font-weight: 500;
    font-style: italic;
    color: var(--color-forest-deep);
    line-height: 1;
    margin-block: 0.25em;
  }

  .inv-dates {
    font-family: var(--font-display);
    font-size: var(--text-s);
    color: var(--color-ink);
    margin-bottom: 0.3em;
  }

  .inv-script {
    font-family: var(--font-hand);
    font-size: var(--text-m);
    color: var(--color-rose-deep);
    line-height: 1;
    margin-top: 0.2em;
  }

  .inv-cta {
    margin-top: var(--space-s);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-old);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--color-gold-old);
  }

  /* ENVELOPE FRONT -------------------------------------- */
  .env-front {
    position: absolute;
    inset: 0 0 25% 0; /* leaves caption strip below */
    z-index: 3;
    background: var(--color-parchment);
    background-image:
      radial-gradient(ellipse at top left, rgba(165, 133, 72, 0.06), transparent 55%),
      radial-gradient(ellipse at bottom right, rgba(193, 156, 143, 0.08), transparent 55%),
      linear-gradient(180deg, var(--color-cream-deep) 0%, var(--color-parchment) 100%);
    transition: transform var(--dur-med) var(--ease-out);
    /* Diagonal flap */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Flap: top V-shape overlaid */
  .env-flap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: var(--color-cream-deep);
    clip-path: polygon(0 0, 50% 65%, 100% 0);
    opacity: 0.7;
    border-bottom: 1px solid var(--color-hairline);
    transition: transform var(--dur-med) var(--ease-out);
  }

  .envelope-wrap:hover .env-flap,
  .envelope-wrap:focus-visible .env-flap {
    transform: translateY(-2%);
  }

  .env-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: var(--space-m);
    position: relative;
  }

  .env-address {
    position: absolute;
    bottom: 25%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    font-family: var(--font-hand);
    color: var(--color-ink);
    opacity: 0.7;
    line-height: 1.15;
  }

  .env-line {
    font-size: var(--text-m);
  }

  .env-line--small {
    font-size: var(--text-s);
    opacity: 0.75;
  }

  /* WAX SEAL -------------------------------------------- */
  .wax-seal {
    position: absolute;
    bottom: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.35), transparent 40%),
      radial-gradient(circle at 60% 60%, var(--color-rose-deep), var(--color-rose-dust));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.1),
      0 3px 8px rgba(43, 38, 32, 0.2);
  }

  .wax-seal-inner {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.3rem;
    line-height: 1;
    transform: rotate(-8deg);
  }

  /* CAPTION strip (matches Postcard footprint) ---------- */
  .env-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 25%;
    z-index: 5;
    padding: var(--space-s) var(--space-m);
    background: var(--color-parchment);
    border-top: 1px solid var(--color-hairline);
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15em;
  }

  .edition {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-old);
  }

  .year {
    font-family: var(--font-display);
    font-size: var(--text-l);
    font-weight: 500;
    color: var(--color-forest-deep);
    line-height: 1;
  }

  .spell {
    font-family: var(--font-display);
    font-size: var(--text-s);
    font-style: italic;
    color: var(--color-forest-soft);
  }

  /* Corner emboss */
  .corner-emboss {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(75, 97, 81, 0.5);
    background: rgba(165, 133, 72, 0.08);
    padding: 0.3em 0.55em;
    border-radius: 100px;
    z-index: 6;
  }
</style>
